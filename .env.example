NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never expose these as NEXT_PUBLIC_* variables.
# SUPABASE_SECRET_KEY is not required for interactive Google OAuth, but will be
# required later for background sync workers that run without a user session.
SUPABASE_SECRET_KEY=
CREDENTIAL_ENCRYPTION_KEY=

# Google OAuth web application credentials.
# Authorized redirect URI:
# https://signalcore-chi.vercel.app/api/connections/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Canonical application origin used for OAuth callbacks.
APP_URL=https://signalcore-chi.vercel.app


# OpenAI Responses API for SignalCore agents.
# Keep OPENAI_API_KEY server-only.
OPENAI_API_KEY=
OPENAI_ROUTINE_MODEL=gpt-6-luna
OPENAI_REASONING_MODEL=gpt-6.1-sol
OPENAI_CODING_MODEL=gpt-6.1-sol


# Background workers. Both must remain server-only.
SUPABASE_SECRET_KEY=
CRON_SECRET=

# Optional specialist providers.
# DataForSEO enables live SERP / competitor evidence for Research & Content.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# GitHub token is optional for public repositories.
# Add a server-only token for private repository read access.
GITHUB_TOKEN=
